T048_STUDENT_EMAIL=student.test@example.com
T048_STUDENT_PASSWORD=
T048_STUDENT_FIREBASE_UID=zIYyvPqiMLPOKkxBwEa4zIPZGPi1

# T048 real-backend integration values. Leave blank until provisioned.
T048_API_BASE_URL=http://host.docker.internal:8080/api/v1
