{
  "mcpServers": {
    "github-projects": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "projects,issues,pull_requests,repos",
        "X-MCP-Readonly": "false"
      }
    }
  }
}
