# Copy this file to .env. Never commit .env or real credentials.

POSTGRES_DB=halaqaty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Firebase project used by FlutterFire and the backend verifier.
FIREBASE_PROJECT_ID=halaqaty-test
# Generate a unique base64 key containing at least 32 random bytes.
# Keep the real value only in your ignored local .env file.
SESSION_MEDIA_ROOM_HMAC_KEY=
# Public Firebase Web API key used only by the local token helper.
FIREBASE_WEB_API_KEY=

# Existing Firebase test users. Keep passwords only in your local .env file.
T048_TEACHER_EMAIL=teacher.test@example.com
T048_TEACHER_PASSWORD=
T048_TEACHER_FIREBASE_UID=InJDagN7cHTGYHWWfOUsq6DGFkA3
T048_STUDENT_EMAIL=student.test@example.com
T048_STUDENT_PASSWORD=
T048_STUDENT_FIREBASE_UID=zIYyvPqiMLPOKkxBwEa4zIPZGPi1

# T048 real-backend integration values. Leave blank until provisioned.
T048_API_BASE_URL=http://host.docker.internal:8080/api/v1
T048_TEACHER_TOKEN=
T048_TEACHER_SESSION=
T048_TEACHER_USER_ID=
T048_STUDENT_TOKEN=
T048_STUDENT_SESSION=
T048_STUDENT_USER_ID=

# T062 real-backend grading-history integration values. Refresh tokens before use.
T062_API_BASE_URL=http://host.docker.internal:8080/api/v1
T062_TEACHER_TOKEN=
T062_TEACHER_SESSION=
