# Copy this file to .env. Never commit .env or real credentials.

POSTGRES_DB=halaqaty
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Firebase project used by FlutterFire and the backend verifier.
FIREBASE_PROJECT_ID=halaqaty-test
# Public Firebase Web API key used only by the local token helper.
FIREBASE_WEB_API_KEY=

# Existing Firebase test users. Keep passwords only in your local .env file.
